# Application
APP_NAME=RadiSense AI
VERSION=1.0.0
DEBUG=True

# Database
DATABASE_URL=mysql+pymysql://root:your_password@localhost/radisense_db

# Security
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads

# Email (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@radisense.ai

# MLflow (Optional)
MLFLOW_TRACKING_URI=http://localhost:5000